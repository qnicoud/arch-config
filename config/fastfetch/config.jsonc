{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "arch_small", // search for logos: fastfetch --list-logos or --print-logos
        "color": {             // Override logo colors
            "1": "#ffb77b",
            "2": "#ffb77b"
        },
        "padding": {
	        "top": 4,
	        "left": 2
        }
	},
    "display": {
        "separator": "  ",
        "color": "#ffb77b"
    },
    "modules": [
	"break",
	{
        "type": "title",
        "key": "           "
    },
    {
        "type": "custom",
        "format": " ╭────────────────────────────────────────╮"
    },
    {
        "type": "os",
        "key": "   󰣇 OS      "
    },
    {   "type": "wm",
        "key" : "   󱂬 WM      "
    },
    {
        "type": "packages",
        "format": "{} (pacman)",
        "key": "   󰏖 Packages"
    },
    {   
        "type": "shell",
        "key": "   󰞷 Shell   "
    },
    {
        "type": "kernel",
        "key": "    Kernel  "
    },
    {
        "type": "uptime",
        "format": "{2}h {3}m",
        "key": "   󰅐 Uptime  "
    },
    {
        "type": "command",
        "key": "   󱘪 OS Age  ",
        "text": "birth_install=$(stat -c %W /); current=$(date +%s);    days_difference=$(( (current - birth_install) / 86400 )); echo $days_difference days"
    },
    {
        "type": "memory",
        "key": "   󰍛 Memory  "
    },
    {
      "type": "custom",
      "format": " ╰────────────────────────────────────────╯"
    },
    {
        "type": "colors",
        "symbol": "circle",
        "key": "            "
    },
    "break"
    ]
}
