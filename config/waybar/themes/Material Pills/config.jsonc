{
  "position": "top",
  "margin-top": 10,
  "modules-left": [
    "group/user-apps#groups",
    "custom/hyprbinds",
    "group/ressource-usage#groups",
    "clock",
    "mpris",
    "hyprland/submap"
  ],
  "modules-center": [
    "custom/weather",
    "hyprland/workspaces",
    "custom/notification"
  ],
  "modules-right": [
    "bluetooth",
    "group/group-volume#groups",
    "network",
    "group/tray-drawer#groups",
    "custom/hyprwhspr"
  ],
  "include": [
    "~/.config/waybar/modules/custom-modules.jsonc",
    "~/.config/waybar/modules/generic-modules.jsonc",
    "~/.config/waybar/modules/hyprland-modules.jsonc",
    "~/.config/waybar/groups.jsonc",
    "~/.config/waybar/hyprwhspr-module.jsonc"
  ]
}
