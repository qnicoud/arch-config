{
  "hyprland/submap" : {
    "format" : "{}",
    "default-submap" : "base",
    "tooltip" : false,
    "icons" : {
      "resize" : " ",
      "swap" : " ",
      "gaming" : " ",
      "base" : " "
    }
  },
  "hyprland/workspaces" : {
    "persistent-workspaces" : {
      "*" : [
        1,
        2,
        3,
        4,
        5
      ]
    },
    "on-click" : "activate",
    "on-scroll-down": "hyprctl dispatch \"hl.dsp.focus({workspace = 'e+1'})\"",
    "on-scroll-up":   "hyprctl dispatch \"hl.dsp.focus({workspace = 'e-1'})\"",
    "format" : "{icon} {windows}",
    "format-icons" : {
      "1" : "一",
      "2" : "二",
      "3" : "三",
      "4" : "四",
      "5" : "五",
      "6" : "六",
      "7" : "七",
      "8" : "八",
      "9" : "九",
      "10" : "十",
      "urgent" : "",
      "focused" : "",
      "default" : ""
    },
    "format-window-separator" : "",
    "window-rewrite-default" : "  ",
    "window-rewrite" : {
      "class<.*imv*.>" : "  ",
      "class<.*bambustudio*.>" : " 󰐫 ",
      "class<.*bitwarden*.>" : "  ",
      "class<.*handbrake*.>" : " 󰈫 ",
      "class<.*stremio*.>" : " 󱖏 ",
      "title<.*waydroid*.>" : "  ",
      "class<.*grayjay*.>" : " 󱗆 ",
      "title<.*amazon.*>" : "  ",
      "class<firefox|org.mozilla.firefox|librewolf|floorp|mercury-browser|[Cc]achy-browser>" : "  ",
      "class<zen>" : " 󰰷 ",
      "class<waterfox|waterfox-bin>" : "  ",
      "class<microsoft-edge>" : "  ",
      "class<Chromium|Thorium|[Cc]hrome>" : "  ",
      "class<brave-browser>" : " 🦁 ",
      "class<tor-browser>" : "  ",
      "class<firefox-developer-edition>" : " 🦊 ",
      "class<kitty|konsole>" : "  ",
      "class<kitty-dropterm>" : "  ",
      "class<com.mitchellh.ghostty>" : "  ",
      "class<org.wezfurlong.wezterm>" : "  ",
      "class<org.omarchy.terminal>" : " 󰏖 ",
      "class<[Tt]hunderbird|[Tt]hunderbird-esr>" : "  ",
      "class<eu.betterbird.Betterbird>" : "  ",
      "class<.*Proton Mail.*>" : "   ",
      "title<.*gmail.*>" : " 󰊫 ",
      "class<[Tt]elegram-desktop|org.telegram.desktop|io.github.tdesktop_x64.TDesktop>" : "  ",
      "class<discord|[Ww]ebcord|Vesktop>" : "  ",
      "title<.*whatsapp.*>" : "  ",
      "title<.*zapzap.*>" : "  ",
      "title<.*messenger.*>" : "  ",
      "title<.*facebook.*>" : "  ",
      "title<.*reddit.*>" : "  ",
      "title<.*ChatGPT.*>" : " 󰚩 ",
      "class<.*ChatGPT.*>" : " 󰚩 ",
      "title<.*deepseek.*>" : " 󰚩 ",
      "title<.*qwen.*>" : " 󰚩 ",
      "class<subl>" : " 󰅳 ",
      "class<slack>" : "  ",
      "class<mpv>" : "  ",
      "class<celluloid|Zoom>" : "  ",
      "class<Cider>" : " 󰎆 ",
      "title<.*Picture-in-Picture.*>" : "  ",
      "title<.*youtube.*>" : "  ",
      "class<vlc>" : " 󰕼 ",
      "title<.*cmus.*>" : "  ",
      "title<.*kew.*>" : "  ",
      "class<[Ss]potify>" : "  ",
      "class<virt-macodeger>" : "  ",
      "class<.virt-manager-wrapped>" : "  ",
      "class<virtualbox manager>" : " 💽",
      "title<virtualbox>" : " 💽",
      "class<remmina>" : " 🖥️",
      "class<VSCode|code-url-handler|code-oss|codium|codium-url-handler|VSCodium>" : " 󰨞 ",
      "class<dev.zed.Zed>" : " 󰵁 ",
      "class<codeblocks>" : " 󰅩 ",
      "title<.*github.*>" : "  ",
      "class<mousepad>" : "  ",
      "class<libreoffice-writer>" : "  ",
      "class<libreoffice-startcenter>" : " 󰏆 ",
      "class<libreoffice-calc>" : "  ",
      "title<.*nvim ~.*>" : "  ",
      "class<Emacs>" : " 󰱯 ",
      "class<org.gnome.Nautilus>" : " 󰣆 ",
      "title<.*vim.*>" : "  ",
      "title<.*figma.*>" : "  ",
      "title<.*jira.*>" : "  ",
