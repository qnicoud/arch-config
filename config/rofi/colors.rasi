// Set colors and font from enviroment variables, with Nord color fallbacks.
// These environment variables are set when Rofi is invoked through the
// script scripts/rofi-wrapper.sh

configuration {
    font:                   env(ROFI_FONT, "Fira Sans 13");
}

* {
    background-color:       transparent;
    background:             env(ROFI_BACKGROUND_COLOR,          #000000);
    background-transparent: env(ROFI_BACKGROUND_TRANSPARENT,    #000000CF);
    text-color:             env(ROFI_TEXT_COLOR,                #D8DEE9);
    primary: #8fcef3;
    primary-fixed: #c3e7ff;
    primary-fixed-dim: #8fcef3;
    on-primary: #003549;
    on-primary-fixed: #001e2c;
    on-primary-fixed-variant: #004c69;
    primary-container: #004c69;
    on-primary-container: #c3e7ff;
    secondary: #b5c9d7;
    secondary-fixed: #d1e5f4;
    secondary-fixed-dim: #b5c9d7;
    on-secondary: #20333e;
    on-secondary-fixed: #0a1e28;
    on-secondary-fixed-variant: #364955;
    secondary-container: #364955;
    on-secondary-container: #d1e5f4;
    tertiary: #cac1ea;
    tertiary-fixed: #e6deff;
    tertiary-fixed-dim: #cac1ea;
    on-tertiary: #322c4c;
    on-tertiary-fixed: #1d1736;
    on-tertiary-fixed-variant: #484264;
    tertiary-container: #484264;
    on-tertiary-container: #e6deff;
    error: #ffb4ab;
    on-error: #690005;
    error-container: #93000a;
    on-error-container: #ffdad6;
    surface: #0f1417;
    on-surface: #dfe3e7;
    on-surface-variant: #c0c7cd;
    outline: #8a9297;
    outline-variant: #41484d;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #dfe3e7;
    inverse-on-surface: #2c3134cc;
    inverse-primary: #1c6585cc;
    surface-dim: #0f1417;
    surface-bright: #353a3d;
    surface-container-lowest: #0a0f12;
    surface-container-low: #181c1f;
    surface-container: #1c2023;
    surface-container-high: #262b2e;
    surface-container-highest: #313539;
}

